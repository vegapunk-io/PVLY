# Copy to .env and export (or use `env $(cat .env | xargs) uvicorn ...`)
PROVENABLY_DATA_DIR=./data
BLOB_TTL_HOURS=24
HASH_ONLY=false
MAX_UPLOAD_MB=200
PROVENABLY_REQUIRE_AUTH=false
RATE_LIMIT_PER_MINUTE=120
# honor X-Forwarded-For for rate limiting; enable only behind a proxy that overwrites it
TRUST_PROXY_HEADERS=false
# comma-separated static API keys; empty = open (local prototype)
PROVENABLY_API_KEYS=
# C2PA trust: official anchors from tools/fetch_trust_list.py; demo anchor for fixtures
TRUST_ANCHORS_PEM=./data/trust/anchors.pem
INCLUDE_DEMO_TRUST_ANCHOR=true
# --- MANUAL INTEGRATION: vendor verifiers ---
OPENAI_VERIFY_API_KEY=
OPENAI_VERIFY_ENDPOINT=
GOOGLE_SYNTHID_ENDPOINT=
GOOGLE_ACCESS_TOKEN=
